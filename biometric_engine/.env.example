# Biometric engine environment template. Copy to .env and fill in real values.
# No real secrets are stored in this file.

# PostgreSQL (async driver) connection URL
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/biometric

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# JWT signing key (replace with a long random secret, e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Cosine-similarity threshold for face verification (0.0 - 1.0)
BIOMETRIC_THRESHOLD=0.85

# Confidence threshold for liveness detection (0.0 - 1.0)
LIVENESS_THRESHOLD=0.7

# Structured logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Allowed CORS origins, comma-separated (frontend dev server by default)
CORS_ORIGINS=http://localhost:5173
